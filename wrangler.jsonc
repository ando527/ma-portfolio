// Cloudflare Workers config for mitchellanderson.com.au: serves the static
// export in out/ as static assets, plus one small Worker script that handles
// POST /api/contact (the contact form). Every other request is answered
// straight from out/ and never runs the Worker.
//
// Cloudflare's Git integration runs `npm run build`, then `npx wrangler deploy`
// on every push to main (other branches get a preview URL). Setup steps are in
// docs/cloudflare-setup.md; the contact form's one-time setup (Turnstile,
// Resend, secrets) is in docs/contact-form-setup.md.
//
// Secrets (set in the dashboard or with `npx wrangler secret put <NAME>`; they
// are not stored in this file and survive deploys):
//   TURNSTILE_SECRET_KEY, RESEND_API_KEY, CONTACT_TO
// For local development copy .dev.vars.example to .dev.vars.
//
// public/_headers is copied into out/ by the build, and Cloudflare applies it
// to every static response: cache lifetimes, HSTS and the other security
// headers. It does not apply to Worker responses, so worker/index.ts sets its
// own headers.
// Test locally with:  npm run build && npx wrangler dev
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "ma-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./out",
    // Lets the Worker hand non-API requests on to the static assets.
    "binding": "ASSETS",
    // Only form posts run the Worker (and count towards the Workers request
    // quota); page views are still served straight from out/.
    "run_worker_first": ["/api/contact"],
    // Unknown paths get out/404.html with a 404 status.
    "not_found_handling": "404-page",
    // /about and /about/ both serve out/about/index.html; the one without the
    // slash redirects, matching trailingSlash: true in next.config.js.
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    // Placeholder sender. Replace it with an address on the domain verified in
    // Resend once Mitchell has set that up (docs/contact-form-setup.md); mail
    // will not send until the domain matches.
    "CONTACT_FROM": "Mitchell Anderson website <contact@mail.mitchellanderson.com.au>"
  }
}
